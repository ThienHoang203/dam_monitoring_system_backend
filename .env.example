# ─────────────────────────────────────────────────────────────
# DAM Monitoring System — Backend environment variables
# Copy sang .env và điền giá trị thật. KHÔNG commit file .env.
# ─────────────────────────────────────────────────────────────

# ── Ứng dụng ──
PORT=3001

# ── Xác thực ──
# BẮT BUỘC, tối thiểu 32 ký tự — JwtModule sẽ throw lúc bootstrap nếu ngắn hơn.
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# Mật khẩu cho tài khoản admin được seed lần đầu (tối thiểu 8 ký tự).
# Bỏ trống -> hệ thống sinh mật khẩu ngẫu nhiên và bắt đổi ở lần đăng nhập đầu.
ADMIN_BOOTSTRAP_PASSWORD=

# ── Cơ sở dữ liệu (PostgreSQL / TimescaleDB) ──
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=dam_monitoring

# ── MinIO (lưu ảnh bằng chứng) ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Endpoint dùng để khởi tạo Minio.Client
MINIO_ENDPOINT=http://127.0.0.1:9000
# Endpoint backend gọi từ bên trong mạng docker (proxy ảnh)
MINIO_INTERNAL_ENDPOINT=http://127.0.0.1:9000
# Endpoint trình duyệt truy cập được; bỏ trống -> ảnh đi qua proxy /sensor/images/*
MINIO_PUBLIC_ENDPOINT=
MINIO_BUCKET=dam-images

# ── MQTT ──
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_SENSOR_TOPIC=dam/sensor/all

# ── Thiết bị biên ──
# API key Gateway/Jetson TX2 phải gửi kèm (header x-gateway-api-key).
# CẢNH BÁO: bỏ trống = tắt xác thực, mọi endpoint ingest mở công khai.
GATEWAY_API_KEY=
JETSON_TX2_URL=

# ── Email cảnh báo (SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DEFAULT_ALERT_EMAIL=

# ── ngrok (tuỳ chọn, chỉ dùng khi expose ra ngoài) ──
NGROK_AUTHTOKEN=
BACKEND_NGROK_DOMAIN=
MINIO_NGROK_DOMAIN=
