# Môi trường dùng cho test — KHÔNG chứa secret thật, an toàn để commit.
# Cổng DB/MQTT lệch với stack dev để chạy song song không đụng nhau.

NODE_ENV=test
PORT=3002

JWT_SECRET=test-secret-key-at-least-32-characters-long-xx
ADMIN_BOOTSTRAP_PASSWORD=test-admin-pass

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=dam_monitoring_test

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_INTERNAL_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_BUCKET=dam-images-test
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

MQTT_BROKER_URL=mqtt://localhost:1884
MQTT_SENSOR_TOPIC=dam/sensor/all

GATEWAY_API_KEY=test-gateway-key

SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DEFAULT_ALERT_EMAIL=alert@example.test
