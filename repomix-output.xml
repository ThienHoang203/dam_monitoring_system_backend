version: '3.8'

services:
  timescaledb:
    image: timescale/timescaledb:latest-pg16
    container_name: dam_timescaledb
    restart: always
    environment:
      POSTGRES_USER: ${DB_USERNAME:-postgres}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-postgres}
      POSTGRES_DB: ${DB_NAME:-dam_monitoring}
    ports:
      - "${DB_PORT:-5432}:5432"
    volumes:
      - timescaledb_data:/var/lib/postgresql/data

  minio:
    image: minio/minio:latest
    container_name: dam_minio
    restart: always
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:-minioadmin}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:-minioadmin}
    ports:
      - "9000:9000"
      - "9001:9001"
    volumes:
      - minio_data:/data
    command: server /data --console-address ":9001"

  minio-init:
    image: minio/mc:latest
    container_name: dam_minio_init
    depends_on:
      - minio
    entrypoint: >
      /bin/sh -c "
      until (/usr/bin/mc alias set local http://minio:9000 ${MINIO_ROOT_USER:-minioadmin} ${MINIO_ROOT_PASSWORD:-minioadmin}) do echo 'Waiting for MinIO...' && sleep 1; done;
      /usr/bin/mc mb --ignore-existing local/${MINIO_BUCKET:-dam-images};
      /usr/bin/mc anonymous set download local/${MINIO_BUCKET:-dam-images};
      exit 0;
      "

  pgweb:
    image: sosedoff/pgweb:latest
    container_name: dam_pgweb
    restart: always
    ports:
      - "8081:8081"
    environment:
      - DATABASE_URL=postgres://${DB_USERNAME:-postgres}:${DB_PASSWORD:-postgres}@timescaledb:5432/${DB_NAME:-dam_monitoring}?sslmode=disable
    depends_on:
      - timescaledb

  mosquitto:
    image: eclipse-mosquitto:latest
    container_name: dam_mosquitto
    restart: always
    ports:
      - "1883:1883"
    volumes:
      - ./mosquitto/config:/mosquitto/config
      - ./mosquitto/data:/mosquitto/data
      - ./mosquitto/log:/mosquitto/log

  backend:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: dam_backend
    restart: always
    ports:
      - "3001:3001"
    environment:
      PORT: 3001
      DB_HOST: timescaledb
      DB_PORT: 5432
      DB_USERNAME: ${DB_USERNAME:-postgres}
      DB_PASSWORD: ${DB_PASSWORD:-postgres}
      DB_NAME: ${DB_NAME:-dam_monitoring}
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:-minioadmin}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:-minioadmin}
      MINIO_ENDPOINT: http://minio:9000
      MINIO_INTERNAL_ENDPOINT: http://minio:9000
      MINIO_BUCKET: ${MINIO_BUCKET:-dam-images}
      MQTT_BROKER_URL: mqtt://mosquitto:1883
      MQTT_SENSOR_TOPIC: ${MQTT_SENSOR_TOPIC:-dam/sensor/all}
      SMTP_HOST: ${SMTP_HOST:-smtp.gmail.com}
      SMTP_PORT: ${SMTP_PORT:-587}
      SMTP_USER: ${SMTP_USER}
      SMTP_PASS: ${SMTP_PASS}
      DEFAULT_ALERT_EMAIL: ${DEFAULT_ALERT_EMAIL}
      JETSON_TX2_URL: ${JETSON_TX2_URL}
      MINIO_PUBLIC_ENDPOINT: ${MINIO_PUBLIC_ENDPOINT}
    depends_on:
      - timescaledb
      - minio
      - mosquitto

  ngrok:
    image: ngrok/ngrok:latest
    container_name: dam_ngrok
    restart: always
    ports:
      - "4040:4040"
    environment:
      NGROK_AUTHTOKEN: ${NGROK_AUTHTOKEN}
      NGROK_DOMAIN: ${BACKEND_NGROK_DOMAIN:-library-opal-degraded.ngrok-free.dev}
    depends_on:
      - backend
    command:
      - "http"
      - "backend:3001"


volumes:
  timescaledb_data:
  minio_data:
